# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GEMINI_API_KEY=
# override if a model gets retired: model used when falling back to that provider
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Seconds before an upstream provider call is abandoned
UPSTREAM_TIMEOUT_S=30

# "real" or "fake" (fake = no provider calls; used for load tests)
PROVIDER_MODE=real

# Local dev (outside docker). docker-compose overrides these to point at its own services.
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://localhost:5432/llm_gateway

# Used by docker-compose for its postgres container. Any value; local only.
POSTGRES_PASSWORD=change-me

# Rate limit per API key: bucket size and tokens added per second
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_S=1
CACHE_TTL_S=3600
